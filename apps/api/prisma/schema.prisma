generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum AuctionStatus {
  OPEN
  CLOSED
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  auctions     Auction[]
  bids         Bid[]

  @@map("users")
}

model Auction {
  id           String        @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  startingPrice Int
  highestBid   Int
  status       AuctionStatus @default(OPEN)
  endsAt       DateTime
  version      Int           @default(0)
  sellerId     String        @db.Uuid
  seller       User          @relation(fields: [sellerId], references: [id])
  bids         Bid[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, endsAt])
  @@index([sellerId])
  @@map("auctions")
}

model Bid {
  id        String   @id @default(uuid()) @db.Uuid
  auctionId String   @db.Uuid
  bidderId  String   @db.Uuid
  amount    Int
  createdAt DateTime @default(now())
  auction   Auction  @relation(fields: [auctionId], references: [id])
  bidder    User     @relation(fields: [bidderId], references: [id])

  @@index([auctionId, createdAt])
  @@index([bidderId])
  @@map("bids")
}
