FROM oven/bun:1.3.9 AS builder

WORKDIR /app

COPY . .

# Build-time defaults for assets/code generation only.
ENV VITE_APP_NAME="Auction Platform"
ENV DATABASE_URL="postgresql://postgres:postgres@localhost:5432/auction_demo?schema=public"

RUN bun install --frozen-lockfile
RUN bun run --filter @auction/web build
RUN bun run --filter @auction/api prisma:generate

FROM oven/bun:1.3.9 AS runner

WORKDIR /app

COPY --from=builder /app /app

ENV NODE_ENV=production
ENV APP_ENV=production

WORKDIR /app/apps/api

EXPOSE 3333

CMD ["bun", "run", "start:production"]