{
  "name": "@auction/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "bun --env-file=.env.development ./node_modules/.bin/prisma generate && bun --env-file=.env.development --watch src/main.ts",
    "dev:watch": "bun --env-file=.env.development --watch src/main.ts",
    "dev:staging": "bun --env-file=.env.staging ./node_modules/.bin/prisma generate && bun --env-file=.env.staging --watch src/main.ts",
    "dev:watch:staging": "bun --env-file=.env.staging --watch src/main.ts",
    "start": "bun --env-file=.env.development ./node_modules/.bin/prisma generate && bun --env-file=.env.development src/main.ts",
    "start:staging": "bun run prisma:generate && bun --env-file=.env.staging src/main.ts",
    "start:production": "bun src/main.ts",
    "lint": "bunx eslint .",
    "test": "bun run test:unit && bun run test:contracts && bun run test:infra",
    "test:unit": "bun test src/application",
    "test:contracts": "bun test src/interfaces",
    "test:infra": "bun test src/infrastructure",
    "test:integration": "bun test src/integration --timeout 30000",
    "test:coverage": "bun test src/application src/interfaces src/infrastructure --coverage",
    "typecheck": "bunx tsc -p tsconfig.json --noEmit",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate:dev": "bunx prisma migrate dev",
    "prisma:migrate:deploy": "bunx prisma migrate deploy",
    "prisma:migrate:deploy:development": "bun --env-file=.env.development ./node_modules/.bin/prisma migrate deploy",
    "prisma:migrate:deploy:staging": "bun --env-file=.env.staging ./node_modules/.bin/prisma migrate deploy",
    "db:seed": "bun run prisma/seed.ts",
    "db:seed:development": "bun --env-file=.env.development prisma/seed.ts",
    "db:seed:staging": "bun --env-file=.env.staging prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/compress": "8.3.1",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@prisma/adapter-pg": "7.4.0",
    "@prisma/client": "7.4.0",
    "cloudinary": "2.9.0",
    "fastify": "^5.7.4",
    "pg": "8.18.0",
    "socket.io": "4.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@auction/config": "workspace:*",
    "@types/pg": "8.16.0",
    "prisma": "7.4.0",
    "socket.io-client": "4.8.3"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  }
}
