# ===========================================
# AUCTION PLATFORM - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env.development / .env.staging and fill in your values.
# NEVER commit files with real credentials.

NODE_ENV=development
APP_ENV=development
API_PORT=3333
# PORT é injetada automaticamente por plataformas como Render.
PORT=3333
# Aceita um ou mais domínios separados por vírgula.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=auction_dev
DATABASE_URL=postgresql://your_db_user:YOUR_STRONG_PASSWORD_HERE@localhost:5432/auction_dev?schema=public

# ===========================================
# AUTHENTICATION
# ===========================================
# JWT_SECRET must be at least 32 characters.
JWT_SECRET=generate-a-secure-32-char-minimum-secret-key-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=generate-a-secure-cookie-secret-32chars
# Set to true in production (HTTPS required).
SECURE_COOKIES=false
# Set to true when running behind Render or another trusted reverse proxy.
TRUST_PROXY=false

# ===========================================
# INTERNAL CRON
# ===========================================
# Segredo usado pelo GitHub Actions para chamar o endpoint interno.
CRON_SECRET=replace-with-a-long-random-secret

# ===========================================
# CLOUD STORAGE (Cloudinary)
# ===========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Max upload size in bytes (default: 10MB)
UPLOAD_MAX_SIZE=10485760
