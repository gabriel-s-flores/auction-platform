{
  "name": "auction-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "powershell -ExecutionPolicy Bypass -File ./infra/setup.ps1",
    "db:setup": "powershell -ExecutionPolicy Bypass -File ./infra/db-setup.ps1 -Environment development",
    "db:setup:staging": "powershell -ExecutionPolicy Bypass -File ./infra/db-setup.ps1 -Environment staging",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File ./infra/migrate.ps1 -Environment development",
    "db:migrate:staging": "powershell -ExecutionPolicy Bypass -File ./infra/migrate.ps1 -Environment staging",
    "dev": "powershell -ExecutionPolicy Bypass -File ./infra/dev.ps1 -Environment development",
    "staging": "powershell -ExecutionPolicy Bypass -File ./infra/dev.ps1 -Environment staging",
    "ps:web:dev": "powershell -ExecutionPolicy Bypass -File ./infra/run-web.ps1 -Environment development",
    "ps:web:staging": "powershell -ExecutionPolicy Bypass -File ./infra/run-web.ps1 -Environment staging",
    "ps:api:dev": "powershell -ExecutionPolicy Bypass -File ./infra/run-api.ps1 -Environment development",
    "ps:api:staging": "powershell -ExecutionPolicy Bypass -File ./infra/run-api.ps1 -Environment staging",
    "check-env": "powershell -ExecutionPolicy Bypass -File ./infra/check-env.ps1",
    "dev:web": "bun run --filter @auction/web dev",
    "dev:web:staging": "bun run --filter @auction/web dev:staging",
    "dev:api": "bun run --filter @auction/api dev",
    "dev:api:staging": "bun run --filter @auction/api dev:staging",
    "db:migrate:api:development": "bun run --filter @auction/api prisma:migrate:deploy:development",
    "db:migrate:api:staging": "bun run --filter @auction/api prisma:migrate:deploy:staging",
    "lint": "bun run lint:web && bun run lint:api && bun run lint:ui && bun run lint:shared-types",
    "lint:web": "bun run --filter @auction/web lint",
    "lint:api": "bun run --filter @auction/api lint",
    "lint:ui": "bun run --filter @auction/ui lint",
    "lint:shared-types": "bun run --filter @auction/shared-types lint",
    "typecheck": "bun run typecheck:web && bun run typecheck:api && bun run typecheck:ui && bun run typecheck:shared-types",
    "typecheck:web": "bun run --filter @auction/web typecheck",
    "typecheck:api": "bun run --filter @auction/api typecheck",
    "typecheck:ui": "bun run --filter @auction/ui typecheck",
    "typecheck:shared-types": "bun run --filter @auction/shared-types typecheck",
    "test": "bun run test:api && bun run test:web && bun run test:ui",
    "test:api": "bun run --filter @auction/api test",
    "test:api:unit": "bun run --filter @auction/api test:unit",
    "test:api:contracts": "bun run --filter @auction/api test:contracts",
    "test:api:infra": "bun run --filter @auction/api test:infra",
    "test:api:integration": "bun run --filter @auction/api test:integration",
    "test:web": "bun run --filter @auction/web test",
    "test:ui": "bun run --filter @auction/ui test",
    "test:e2e": "bun run --filter @auction/web test:e2e",
    "test:storybook": "bun run --filter @auction/ui test:storybook",
    "test:infra": "make test-integration",
    "test:all": "bun run test && bun run test:storybook && bun run test:e2e && bun run test:infra",
    "storybook": "bun run --filter @auction/ui storybook",
    "storybook:build": "bun run --filter @auction/ui storybook:build",
    "format": "bunx prettier --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "bunx eslint --max-warnings=0 --fix",
      "bunx prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "bunx prettier --write"
    ]
  },
  "resolutions": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "overrides": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.59.1",
    "@tanstack/eslint-plugin-query": "5.91.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.3.9",
    "@types/node": "25.2.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.56.0",
    "@typescript-eslint/parser": "8.56.0",
    "autoprefixer": "10.4.24",
    "bun-types": "1.3.9",
    "eslint": "10.0.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.2.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-sonarjs": "3.0.7",
    "globals": "17.3.0",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "postcss": "8.5.6",
    "prettier": "3.8.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.0",
    "vitest": "4.1.5"
  }
}
