# =========================================== # AUCTION PLATFORM - ENVIRONMENT CONFIGURATION # =========================================== # Copy this file to .env.development and fill in your values # NEVER commit files with real credentials! # =========================================== NODE_ENV=development APP_ENV=development API_PORT=3333 CORS_ORIGIN=http://localhost:5173 LOG_LEVEL=debug # =========================================== # DATABASE CONFIGURATION # =========================================== # IMPORTANT: Use strong passwords in production! POSTGRES_HOST=localhost POSTGRES_PORT=5432 POSTGRES_USER=your_db_user POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE POSTGRES_DB=auction_dev DATABASE_URL=postgresql://your_db_user:YOUR_STRONG_PASSWORD_HERE@localhost:5432/auction_dev?schema=public # =========================================== # AUTHENTICATION # =========================================== # JWT_SECRET must be at least 32 characters # Generate a secure secret: openssl rand -base64 32 JWT_SECRET=generate-a-secure-32-char-minimum-secret-key-here # Access token expiration (default: 15 minutes) JWT_EXPIRES_IN=15m # Refresh token expiration (default: 7 days) JWT_REFRESH_EXPIRES_IN=7d # COOKIE_SECRET must be at least 32 characters # Used for signing cookies COOKIE_SECRET=generate-a-secure-cookie-secret-32chars # Set to true in production for secure cookies (HTTPS required) SECURE_COOKIES=false # =========================================== # CLOUD STORAGE (Cloudinary) # =========================================== # Get credentials from: https://cloudinary.com/console # NEVER share or commit these credentials! CLOUDINARY_CLOUD_NAME=your_cloud_name CLOUDINARY_API_KEY=your_api_key CLOUDINARY_API_SECRET=your_api_secret # Max upload size in bytes (default: 10MB) UPLOAD_MAX_SIZE=10485760