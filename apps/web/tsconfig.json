{
  "extends": "../../packages/config/tsconfig/react.json",
  "compilerOptions": {
    "types": ["vite/client", "node"],
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["./src/*"],
      "@ui/*": ["../../packages/ui/src/*"],
      "@auction/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@auction/shared-types/*": ["../../packages/shared-types/src/*"],
      "@auction/ui": ["../../packages/ui/src/index.ts"],
      "@auction/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "src",
    "e2e",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tailwind.config.ts",
    "src/vite-env.d.ts",
    "../../packages/shared-types/src",
    "../../packages/ui/src/index.ts",
    "../../packages/ui/src/components",
    "../../packages/ui/src/utils"
  ]
}
