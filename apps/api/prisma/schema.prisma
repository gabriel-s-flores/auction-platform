generator client {
 provider = "prisma-client-js"
}

datasource db {
 provider = "postgresql"
}

enum UserRole {
 USER
 ADMIN
 SUPER_ADMIN
}

enum AuctionStatus {
 PENDING_APPROVAL
 OPEN
 CLOSED
 REJECTED
}

enum EditStatus {
 PENDING_APPROVAL
 APPROVED
 REJECTED
}

enum EditType {
 TITLE
 DESCRIPTION
 IMAGES
}

model User {
 id String @id @default(uuid()) @db.Uuid
 name String
 email String @unique
 passwordHash String
 role UserRole @default(USER)
 isBanned Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 // Relacionamentos
 auctions Auction[] @relation("SellerAuctions")
 bids Bid[]
 approvedAuctions Auction[] @relation("ApprovedAuctions")
 submittedEdits PendingAuctionEdit[] @relation("SubmittedEdits")
 reviewedEdits PendingAuctionEdit[] @relation("ReviewedEdits")
 activityLogs ActivityLog[]

 @@index([role])
 @@index([isBanned])
 @@map("users")
}

model Auction {
 id String @id @default(uuid()) @db.Uuid
 title String
 description String?
 startingPrice Int
 highestBid Int
 status AuctionStatus @default(PENDING_APPROVAL)
 endsAt DateTime
 version Int @default(0)
 rejectionReason String?
 approvedById String? @db.Uuid
 approvedAt DateTime?
 sellerId String @db.Uuid
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 // Relacionamentos
 seller User @relation("SellerAuctions", fields: [sellerId], references: [id])
 approvedBy User? @relation("ApprovedAuctions", fields: [approvedById], references: [id])
 bids Bid[]
 images Image[]
 pendingEdits PendingAuctionEdit[]

 @@index([status, endsAt])
 @@index([sellerId])
 @@index([status])
 @@map("auctions")
}

model Image {
 id String @id @default(uuid()) @db.Uuid
 auctionId String @db.Uuid
 url String
 publicId String?
 alt String?
 position Int @default(0)
 isPrimary Boolean @default(false)
 mimeType String
 size Int
 createdAt DateTime @default(now())

 auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

 @@index([auctionId])
 @@index([auctionId, position])
 @@map("images")
}

model Bid {
 id String @id @default(uuid()) @db.Uuid
 auctionId String @db.Uuid
 bidderId String @db.Uuid
 amount Int
 createdAt DateTime @default(now())

 auction Auction @relation(fields: [auctionId], references: [id])
 bidder User @relation(fields: [bidderId], references: [id])

 @@index([auctionId, createdAt])
 @@index([bidderId])
 @@map("bids")
}

model PendingAuctionEdit {
 id String @id @default(uuid()) @db.Uuid
 auctionId String @db.Uuid
 editType EditType
 oldValue Json?
 newValue Json
 status EditStatus @default(PENDING_APPROVAL)
 rejectionReason String?
 submittedById String @db.Uuid
 reviewedById String? @db.Uuid
 reviewedAt DateTime?
 createdAt DateTime @default(now())

 // Relacionamentos
 auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)
 submittedBy User @relation("SubmittedEdits", fields: [submittedById], references: [id])
 reviewedBy User? @relation("ReviewedEdits", fields: [reviewedById], references: [id])

 @@index([auctionId])
 @@index([status])
 @@index([submittedById])
 @@map("pending_auction_edits")
}

model ActivityLog {
 id String @id @default(uuid()) @db.Uuid
 action String
 entityType String
 entityId String @db.Uuid
 actorId String? @db.Uuid
 metadata Json?
 ipAddress String?
 userAgent String?
 createdAt DateTime @default(now())

 // Relacionamentos
 actor User? @relation(fields: [actorId], references: [id])

 @@index([action])
 @@index([entityType, entityId])
 @@index([actorId])
 @@index([createdAt])
 @@map("activity_logs")
}
