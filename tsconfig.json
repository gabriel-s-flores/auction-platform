{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@auction/config/*": ["./packages/config/*"]
    },
    "allowJs": true,
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": ["tailwind.config.ts"],
  "references": [
    { "path": "./packages/shared-types" },
    { "path": "./packages/ui" },
    { "path": "./apps/api" },
    { "path": "./apps/web" }
  ]
}
