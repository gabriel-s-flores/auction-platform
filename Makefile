POSTGRES_USER ?= admin
POSTGRES_PASSWORD ?= admin
POSTGRES_DB ?= auction_dev
POSTGRES_TEST_DB ?= auction_test
DATABASE_URL_HOST ?= postgresql://$(POSTGRES_USER):$(POSTGRES_PASSWORD)@localhost:5432/$(POSTGRES_DB)?schema=public
TEST_DATABASE_URL_DOCKER ?= postgresql://$(POSTGRES_USER):$(POSTGRES_PASSWORD)@postgres:5432/$(POSTGRES_TEST_DB)?schema=public
API_ENV_FILE := apps/api/.env.development
WEB_ENV_FILE := apps/web/.env.development
WEB_LEGACY_ENV_FILE := apps/web/.env

.PHONY: help check-docker setup-env setup dev storybook storybook-build rebuild down clean logs shell-api shell-web shell-storybook migrate seed lint typecheck test test-db test-db-migrate test-integration test-all

help:
	@echo "Available commands:"
	@echo "  make setup      - Create env files, build containers, and setup database"
	@echo "  make setup-env  - Create local development env files if missing"
	@echo "  make dev        - Start development environment"
	@echo "  make storybook  - Start Storybook in Docker"
	@echo "  make storybook-build - Build Storybook in Docker"
	@echo "  make rebuild    - Rebuild containers and refresh anonymous volumes"
	@echo "  make down       - Stop development environment"
	@echo "  make clean      - Stop and remove volumes (reset db)"
	@echo "  make logs       - View logs"
	@echo "  make shell-api  - Open bash in api container"
	@echo "  make shell-web  - Open bash in web container"
	@echo "  make shell-storybook - Open bash in storybook container"
	@echo "  make migrate    - Run prisma migrations"
	@echo "  make seed       - Run database seed"
	@echo "  make lint       - Run lint in Docker"
	@echo "  make typecheck  - Run typecheck in Docker"
	@echo "  make test       - Run fast automated tests"
	@echo "  make test-db    - Create the integration test database"
	@echo "  make test-integration - Run database integration tests"
	@echo "  make test-all   - Run fast tests and database integration tests"

check-docker:
	@command -v docker >/dev/null 2>&1 || { echo "Docker is required for Makefile targets." >&2; exit 1; }
	@docker compose version >/dev/null 2>&1 || { echo "Docker Compose plugin is required for Makefile targets." >&2; exit 1; }
	@docker info >/dev/null 2>&1 || { echo "Docker daemon is not running." >&2; exit 1; }

setup-env:
	@if [ ! -f $(WEB_ENV_FILE) ]; then cp apps/web/.env.example $(WEB_ENV_FILE) && echo "Created $(WEB_ENV_FILE) from .env.example"; else echo "$(WEB_ENV_FILE) already exists"; fi
	@if [ ! -f $(WEB_LEGACY_ENV_FILE) ]; then cp apps/web/.env.example $(WEB_LEGACY_ENV_FILE) && echo "Created $(WEB_LEGACY_ENV_FILE) from .env.example"; else echo "$(WEB_LEGACY_ENV_FILE) already exists"; fi
	@if [ ! -f $(API_ENV_FILE) ]; then \
		jwt_secret=$$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 64); \
		cookie_secret=$$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 64); \
		cron_secret=$$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 64); \
		cloudinary_secret=$$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 64); \
		{ \
			printf '%s\n' '# Generated by make setup for local development.'; \
			printf '%s\n' '# Replace Cloudinary placeholders with real development credentials to test image uploads.'; \
			printf '%s\n' 'NODE_ENV=development'; \
			printf '%s\n' 'APP_ENV=development'; \
			printf '%s\n' 'API_PORT=3333'; \
			printf '%s\n' 'PORT=3333'; \
			printf '%s\n' 'CORS_ORIGIN=http://localhost:5173'; \
			printf '%s\n' 'LOG_LEVEL=debug'; \
			printf '%s\n' 'POSTGRES_HOST=localhost'; \
			printf '%s\n' 'POSTGRES_PORT=5432'; \
			printf '%s\n' 'POSTGRES_USER=$(POSTGRES_USER)'; \
			printf '%s\n' 'POSTGRES_PASSWORD=$(POSTGRES_PASSWORD)'; \
			printf '%s\n' 'POSTGRES_DB=$(POSTGRES_DB)'; \
			printf '%s\n' 'DATABASE_URL=$(DATABASE_URL_HOST)'; \
			printf '%s\n' "JWT_SECRET=$$jwt_secret"; \
			printf '%s\n' 'JWT_EXPIRES_IN=15m'; \
			printf '%s\n' 'JWT_REFRESH_EXPIRES_IN=7d'; \
			printf '%s\n' "COOKIE_SECRET=$$cookie_secret"; \
			printf '%s\n' 'SECURE_COOKIES=false'; \
			printf '%s\n' 'TRUST_PROXY=false'; \
			printf '%s\n' "CRON_SECRET=$$cron_secret"; \
			printf '%s\n' 'CLOUDINARY_CLOUD_NAME=local-dev-placeholder'; \
			printf '%s\n' 'CLOUDINARY_API_KEY=local-dev-placeholder'; \
			printf '%s\n' "CLOUDINARY_API_SECRET=$$cloudinary_secret"; \
			printf '%s\n' 'UPLOAD_MAX_SIZE=10485760'; \
		} > $(API_ENV_FILE); \
		echo "Created $(API_ENV_FILE) with local development defaults"; \
	else \
		echo "$(API_ENV_FILE) already exists"; \
	fi

setup: check-docker setup-env
	docker compose build api web
	docker compose up -d postgres
	@echo "Waiting for postgres to be ready..."
	@until docker compose exec -T postgres pg_isready -U $(POSTGRES_USER) -d $(POSTGRES_DB) >/dev/null 2>&1; do sleep 1; done
	docker compose run --rm api bun run prisma:migrate:deploy
	docker compose run --rm api bun run db:seed
	docker compose down
	@echo "Setup complete. Run 'make dev' to start."


# Start development environment
dev: check-docker setup-env
	docker compose up

storybook: check-docker setup-env
	docker compose up storybook

storybook-build: check-docker setup-env
	docker compose run --rm --no-deps storybook bun run --cwd packages/ui storybook:build

# Rebuild containers and force refresh of anonymous volumes (node_modules)
# Use this when dependencies change (e.g. package.json updates) or when seeing stale errors
rebuild: check-docker setup-env
	docker compose down
	docker compose up -d --build --force-recreate -V


down: check-docker setup-env
	docker compose down

clean: check-docker setup-env
	docker compose down -v
	docker system prune -f

logs: check-docker setup-env
	docker compose logs -f

shell-api: check-docker setup-env
	docker compose exec api /bin/bash

shell-web: check-docker setup-env
	docker compose exec web /bin/bash

shell-storybook: check-docker setup-env
	docker compose exec storybook /bin/bash

migrate: check-docker setup-env
	docker compose run --rm api bun run prisma:migrate:deploy

seed: check-docker setup-env
	docker compose run --rm api bun run db:seed

lint: check-docker setup-env
	docker compose run --rm --no-deps web bun run lint

typecheck: check-docker setup-env
	docker compose run --rm --no-deps web bun run typecheck

test: check-docker setup-env
	docker compose run --rm --no-deps web bun run test

test-db: check-docker setup-env
	docker compose up -d postgres
	@echo "Waiting for postgres to be ready..."
	@until docker compose exec -T postgres pg_isready -U $(POSTGRES_USER) -d $(POSTGRES_DB) >/dev/null 2>&1; do sleep 1; done
	docker compose exec -T postgres sh -lc 'createdb -U "$${POSTGRES_USER:-admin}" "$(POSTGRES_TEST_DB)" 2>/dev/null || true'
	@echo "Test database '$(POSTGRES_TEST_DB)' is ready."

test-db-migrate: test-db
	docker compose run --rm -e DATABASE_URL="$(TEST_DATABASE_URL_DOCKER)" api bun run prisma:migrate:deploy

test-integration: test-db-migrate
	docker compose run --rm -e DATABASE_URL="$(TEST_DATABASE_URL_DOCKER)" -e TEST_DATABASE_URL="$(TEST_DATABASE_URL_DOCKER)" -e NODE_ENV=test api bun run test:integration

test-all: test test-integration
